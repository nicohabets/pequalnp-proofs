theorem cover (m : ℕ) (hlt : m < 2 ^ 32) (hm : MonoM m) : ∃ p, valid m p = true := by
  have b0 := byte_mono m hm 0 (by norm_num)
  have b1 := byte_mono m hm 1 (by norm_num)
  have b2 := byte_mono m hm 2 (by norm_num)
  have b3 := byte_mono m hm 3 (by norm_num)
  have l0 : byte m 0 < 256 := Nat.mod_lt _ (by norm_num)
  have l1 : byte m 1 < 256 := Nat.mod_lt _ (by norm_num)
  have l2 : byte m 2 < 256 := Nat.mod_lt _ (by norm_num)
  have l3 : byte m 3 < 256 := Nat.mod_lt _ (by norm_num)
  have s01 := byte_sub m hm 0 1 (by decide)
  have s02 := byte_sub m hm 0 2 (by decide)
  have s13 := byte_sub m hm 1 3 (by decide)
  have s23 := byte_sub m hm 2 3 (by decide)
  have h0 := M3_complete _ l0 b0
  have hmem := mem_enum2 (byte m 0) (byte m 1) _ _ (M3_complete _ l2 b2)
    (M3_complete _ l3 b3) s02 s13 s23
  rw [comb, byte_decomp m hlt] at hmem
  exact chk_mem _ _ (chunk_all _ h0 _ (M3_complete _ l1 b1) s01) m hmem

theorem main (S : Finset ℕ) (hS : ∀ t ∈ reps, t ∈ S)
    (hyp : ∀ T ∈ S, ∀ s : ℕ, HasCircuitSize 5 (fun x : Fin 5 → Bool => Nat.testBit T (idx x)) s →
      ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) =
        Nat.testBit T (idx x))
    (f : (Fin 5 → Bool) → Bool)
    (hf : ∀ x y : Fin 5 → Bool, (∀ i, x i = true → y i = true) → f x = true → f y = true)
    (s : ℕ) (hs : HasCircuitSize 5 f s) :
    ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = f x := by
  obtain ⟨C, hC, hsz, hev⟩ := hs
  have hm : MonoM (maskOf f) := by
    intro k k' hk hk' hsub hb
    rw [testBit_maskOf f k' hk']
    rw [testBit_maskOf f k hk] at hb
    exact hf _ _ (fun i hi => hsub i i.isLt hi) hb
  obtain ⟨p, hv⟩ := cover (maskOf f) (maskOf_lt f) hm
  simp only [valid, Bool.and_eq_true, decide_eq_true_eq] at hv
  obtain ⟨hp, hc⟩ := hv
  have hT : applyP p (maskOf f) ∈ S := hS _ (List.contains_iff_mem.mp hc)
  have hTf : ∀ x : Fin 5 → Bool, (applyP p (maskOf f)).testBit (idx x) = f (x ∘ pi p) := by
    intro x
    rw [testBit_applyP p _ _ hp (idx_lt x), pIdx_idx, maskOf_spec]
  have hCT : HasCircuitSize 5 (fun x : Fin 5 → Bool => Nat.testBit (applyP p (maskOf f)) (idx x)) s :=
    ⟨ren (pi p) C, ren_fan _ _ hC, by rw [ren_size]; exact hsz, fun x => (ren_eval _ _ _).trans ((hev _).trans (hTf x).symm)⟩
  obtain ⟨D, hD, hDs, hDe⟩ := hyp _ hT s hCT
  refine ⟨ren (rho p) D, ren_mono _ _ hD, by rw [ren_size]; exact hDs, fun x => ?_⟩
  refine (ren_eval _ _ _).trans ((hDe _).trans ((hTf _).trans (congrArg f ?_)))
  funext i
  simp [Function.comp, rho_pi p hp]

