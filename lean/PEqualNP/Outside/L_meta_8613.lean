def comb (a0 a1 a2 a3 : ℕ) : ℕ := a0 + 256 * a1 + 65536 * a2 + 16777216 * a3

def enum2 (a0 a1 : ℕ) : List ℕ :=
  M3.flatMap fun a2 => if subB a0 a2 then
    (M3.filter fun a3 => subB a1 a3 && subB a2 a3).map (comb a0 a1 a2) else []

theorem mem_enum2 (a0 a1 a2 a3 : ℕ) (h2 : a2 ∈ M3) (h3 : a3 ∈ M3)
    (s02 : subB a0 a2 = true) (s13 : subB a1 a3 = true)
    (s23 : subB a2 a3 = true) : comb a0 a1 a2 a3 ∈ enum2 a0 a1 := by
  simp only [enum2, List.mem_flatMap]
  refine ⟨a2, h2, ?_⟩
  rw [if_pos s02]
  exact List.mem_map.mpr ⟨a3, List.mem_filter.mpr ⟨h3, by simp [s13, s23]⟩, rfl⟩

def pIdx (s : List ℕ) (k : ℕ) : ℕ := idx fun i => k.testBit (s.getD i 0 % 5)

def pIdxC (s : List ℕ) (k : ℕ) : ℕ := (if k.testBit (s.getD 0 0 % 5) then 1 else 0) +
  (if k.testBit (s.getD 1 0 % 5) then 2 else 0) + (if k.testBit (s.getD 2 0 % 5) then 4 else 0) +
  (if k.testBit (s.getD 3 0 % 5) then 8 else 0) + (if k.testBit (s.getD 4 0 % 5) then 16 else 0)

theorem pIdx_eq (s : List ℕ) (k : ℕ) : pIdx s k = pIdxC s k := by
  rw [pIdx, idx_eq]; rfl

def applyP (p m : ℕ) : ℕ := bitsToNat ((PT.getD p []).map fun j => m.testBit j)

def valid (m p : ℕ) : Bool := decide (p < 120) && reps.contains (applyP p m)

def chk : List ℕ → List ℕ → Bool
  | [], _ => true
  | _ :: _, [] => false
  | m :: ms, p :: ps => valid m p && chk ms ps

theorem chk_mem : ∀ (E P : List ℕ), chk E P = true → ∀ m ∈ E, ∃ p, valid m p = true
  | [], _, _, m, hm => by simp at hm
  | _ :: _, [], h, _, _ => by simp [chk] at h
  | a :: ms, p :: ps, h, m, hm => by
    simp only [chk, Bool.and_eq_true] at h
    rcases List.mem_cons.mp hm with rfl | hm'
    · exact ⟨p, h.1⟩
    · exact chk_mem ms ps h.2 m hm'

def chunkOK (a0 a1 : ℕ) : Bool := chk (enum2 a0 a1) (certFor a0 a1)

