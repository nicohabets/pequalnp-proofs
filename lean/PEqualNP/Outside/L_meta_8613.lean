import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_8613

-- The fold lemmas below (step, W and their properties), remap and simN are taken from the
-- checked file L_meta_6567.lean of this repository (step L-meta-6567 by Tristan Hornetz, which
-- took the fold lemmas from L_meta_5465.lean by Maxime Moisant; Apache-2.0).

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

def W (gs : List Gate) (w : List Bool) : List Bool := gs.foldl step w

theorem W_append (a b : List Gate) (w : List Bool) : W (a ++ b) w = W b (W a w) := by
  simp [W, List.foldl_append]

theorem W_snoc (gs : List Gate) (g : Gate) (w : List Bool) : W (gs ++ [g]) w = step (W gs w) g := by
  rw [W_append]; rfl

theorem step_len (w : List Bool) (g : Gate) : (step w g).length = w.length + 1 := by
  simp [step]

theorem W_length (gs : List Gate) :
    ∀ w : List Bool, (W gs w).length = w.length + gs.length := by
  induction gs with
  | nil => intro w; simp [W]
  | cons g gs ih =>
    intro w
    show (W gs (step w g)).length = _
    rw [ih, step_len, List.length_cons]
    omega

theorem getD_app_lt (l l2 : List Bool) (i : ℕ) (h : i < l.length) :
    (l ++ l2).getD i false = l.getD i false := by
  simp [List.getD, List.getElem?_append_left h]

theorem getD_app_len (l : List Bool) (v : Bool) : (l ++ [v]).getD l.length false = v := by
  simp [List.getD]

theorem getD_ge (l : List Bool) (i : ℕ) (h : l.length ≤ i) : l.getD i false = false := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none h]

theorem step_lt (w : List Bool) (g : Gate) (i : ℕ) (h : i < w.length) :
    (step w g).getD i false = w.getD i false := getD_app_lt w _ i h

theorem step_last (w : List Bool) (g : Gate) (k : ℕ) (hk : k = w.length) :
    (step w g).getD k false = g.op.eval (g.inputs.map fun i => w.getD i false) := by
  subst hk; exact getD_app_len w _

theorem W_snoc_getD (gs : List Gate) (g : Gate) (w : List Bool) (t : ℕ) :
    (W (gs ++ [g]) w).getD t false =
      if t = w.length + gs.length then g.op.eval (g.inputs.map fun i => (W gs w).getD i false)
      else (W gs w).getD t false := by
  rw [W_snoc]
  by_cases ht : t = w.length + gs.length
  · rw [if_pos ht, step_last _ _ _ (by rw [W_length]; exact ht)]
  · rw [if_neg ht]
    by_cases hlt : t < w.length + gs.length
    · exact step_lt _ _ _ (by rw [W_length]; exact hlt)
    · rw [getD_ge _ _ (by rw [step_len, W_length]; omega), getD_ge _ _ (by rw [W_length]; omega)]

theorem ofFn_getD {n : ℕ} (x : Fin n → Bool) (u : ℕ) (hu : u < n) :
    (List.ofFn x).getD u false = x ⟨u, hu⟩ := by
  simp [List.getD_eq_getElem?_getD, hu]

theorem ofFn_getD_ge {n : ℕ} (x : Fin n → Bool) (u : ℕ) (hu : n ≤ u) :
    (List.ofFn x).getD u false = false := getD_ge _ _ (by simpa using hu)

def remap (r : ℕ → ℕ) (g : Gate) : Gate := ⟨g.op, g.inputs.map r⟩

theorem simN (r : ℕ → ℕ) (wa wb : List Bool) (N : ℕ)
    (hbase : ∀ i, wb.getD (r i) false = wa.getD i false)
    (hr : ∀ i k, k < N → (r i = wb.length + k ↔ i = wa.length + k)) :
    ∀ (gs : List Gate), gs.length ≤ N → ∀ (i : ℕ),
      (W (gs.map (remap r)) wb).getD (r i) false = (W gs wa).getD i false := by
  intro gs
  induction gs using List.reverseRecOn with
  | nil => intro _ i; exact hbase i
  | append_singleton gs g ih =>
    intro hlen i
    have hlen' : gs.length < N := by
      simp only [List.length_append, List.length_cons, List.length_nil] at hlen
      omega
    have ih' := ih (by omega)
    rw [List.map_append, List.map_cons, List.map_nil, W_snoc_getD, W_snoc_getD, List.length_map]
    by_cases hi : i = wa.length + gs.length
    · rw [if_pos ((hr i gs.length hlen').mpr hi), if_pos hi]
      show g.op.eval ((g.inputs.map r).map _) = _
      rw [List.map_map]
      congr 1
      apply List.map_congr_left
      intro j _
      exact ih' j
    · rw [if_neg (fun h => hi ((hr i gs.length hlen').mp h)), if_neg hi]
      exact ih' i

/-! ## Renaming the five input wires -/

def rn (ρ : Fin 5 → Fin 5) (i : ℕ) : ℕ := if h : i < 5 then (ρ ⟨i, h⟩ : ℕ) else i

def ren (ρ : Fin 5 → Fin 5) (C : Circuit) : Circuit := ⟨C.gates.map (remap (rn ρ)), rn ρ C.output⟩

theorem ren_size (ρ : Fin 5 → Fin 5) (C : Circuit) : (ren ρ C).size = C.size := by
  simp [ren, Circuit.size]

theorem ren_eval (ρ : Fin 5 → Fin 5) (C : Circuit) (x : Fin 5 → Bool) :
    (ren ρ C).eval (List.ofFn x) = C.eval (List.ofFn (x ∘ ρ)) := by
  show (W (C.gates.map (remap (rn ρ))) (List.ofFn x)).getD (rn ρ C.output) false =
    (W C.gates (List.ofFn (x ∘ ρ))).getD C.output false
  refine simN (rn ρ) (List.ofFn (x ∘ ρ)) (List.ofFn x) C.gates.length ?_ ?_ C.gates le_rfl C.output
  · intro i
    unfold rn
    split_ifs with h
    · rw [ofFn_getD x _ (ρ ⟨i, h⟩).isLt, ofFn_getD _ i h]; rfl
    · rw [ofFn_getD_ge _ _ (by omega), ofFn_getD_ge _ _ (by omega)]
  · intro i k _
    simp only [List.length_ofFn]
    unfold rn
    split_ifs with h
    · have := (ρ ⟨i, h⟩).isLt
      constructor <;> intro h' <;> omega
    · exact Iff.rfl

theorem ren_fan (ρ : Fin 5 → Fin 5) (C : Circuit) (h : FanInTwo C) : FanInTwo (ren ρ C) := by
  unfold FanInTwo at h ⊢
  intro g hg
  simp only [ren, List.mem_map] at hg
  obtain ⟨g0, hg0, rfl⟩ := hg
  have := h g0 hg0
  exact ⟨this.1, by simpa [remap] using this.2⟩

theorem ren_mono (ρ : Fin 5 → Fin 5) (C : Circuit) (h : Monotone2 C) : Monotone2 (ren ρ C) := by
  unfold Monotone2 at h ⊢
  intro g hg
  simp only [ren, List.mem_map] at hg
  obtain ⟨g0, hg0, rfl⟩ := hg
  have := h g0 hg0
  exact ⟨this.1, by simpa [remap] using this.2⟩

/-! ## Truth tables as numbers -/

def bitsToNat : List Bool → ℕ
  | [] => 0
  | b :: l => Nat.bit b (bitsToNat l)

theorem testBit_bitsToNat : ∀ (l : List Bool) (i : ℕ), (bitsToNat l).testBit i = l.getD i false
  | [], i => by simp [bitsToNat]
  | b :: l, 0 => by simp [bitsToNat]
  | b :: l, i + 1 => by simp [bitsToNat, Nat.testBit_bit_succ, testBit_bitsToNat l i]

def idx (x : Fin 5 → Bool) : ℕ := ∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0

theorem idx_eq (x : Fin 5 → Bool) : idx x = (if x 0 then 1 else 0) + (if x 1 then 2 else 0) +
    (if x 2 then 4 else 0) + (if x 3 then 8 else 0) + (if x 4 then 16 else 0) := by
  rw [idx, Fin.sum_univ_five]; rfl

theorem five (a b c d e : Bool) :
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) +
      (if e then 16 else 0) : ℕ) < 32 ∧
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) +
      (if e then 16 else 0) : ℕ).testBit 0 = a ∧
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) +
      (if e then 16 else 0) : ℕ).testBit 1 = b ∧
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) +
      (if e then 16 else 0) : ℕ).testBit 2 = c ∧
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) +
      (if e then 16 else 0) : ℕ).testBit 3 = d ∧
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) +
      (if e then 16 else 0) : ℕ).testBit 4 = e := by
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> decide

theorem idx_lt (x : Fin 5 → Bool) : idx x < 32 := by
  rw [idx_eq]; exact (five _ _ _ _ _).1

theorem tb (x : Fin 5 → Bool) (j : ℕ) (hj : j < 5) : (idx x).testBit j = x ⟨j, hj⟩ := by
  rw [idx_eq]
  obtain ⟨_, h0, h1, h2, h3, h4⟩ := five (x 0) (x 1) (x 2) (x 3) (x 4)
  match j, hj with
  | 0, _ => exact h0
  | 1, _ => exact h1
  | 2, _ => exact h2
  | 3, _ => exact h3
  | 4, _ => exact h4

def bitsOf (k : ℕ) : Fin 5 → Bool := fun i => k.testBit i

theorem bitsOf_idx (x : Fin 5 → Bool) : bitsOf (idx x) = x := by
  funext i; exact tb x i i.isLt

def maskOf (f : (Fin 5 → Bool) → Bool) : ℕ := bitsToNat (List.ofFn fun k : Fin 32 => f (bitsOf k))

theorem testBit_maskOf (f : (Fin 5 → Bool) → Bool) (k : ℕ) (hk : k < 32) :
    (maskOf f).testBit k = f (bitsOf k) := by
  rw [maskOf, testBit_bitsToNat, ofFn_getD _ k hk]

theorem testBit_maskOf_ge (f : (Fin 5 → Bool) → Bool) (k : ℕ) (hk : 32 ≤ k) :
    (maskOf f).testBit k = false := by
  rw [maskOf, testBit_bitsToNat, ofFn_getD_ge _ k hk]

theorem maskOf_lt (f : (Fin 5 → Bool) → Bool) : maskOf f < 2 ^ 32 :=
  Nat.lt_pow_two_of_testBit _ fun i hi => testBit_maskOf_ge f i hi

theorem maskOf_spec (f : (Fin 5 → Bool) → Bool) (x : Fin 5 → Bool) :
    (maskOf f).testBit (idx x) = f x := by
  rw [testBit_maskOf f _ (idx_lt x), bitsOf_idx]

/-! ## Bytes of a monotone table -/

def byte (m j : ℕ) : ℕ := m / 2 ^ (8 * j) % 2 ^ 8

theorem testBit_byte (m j k : ℕ) : (byte m j).testBit k = (decide (k < 8) && m.testBit (k + 8 * j)) := by
  rw [byte, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]

theorem byte_decomp (m : ℕ) (h : m < 2 ^ 32) :
    byte m 0 + 256 * byte m 1 + 65536 * byte m 2 + 16777216 * byte m 3 = m := by
  unfold byte
  norm_num
  omega

def mono3B (a : ℕ) : Bool :=
  (List.range 8).all fun k => (List.range 3).all fun b => !a.testBit k || a.testBit (k ||| 2 ^ b)

def subB (a b : ℕ) : Bool := (List.range 8).all fun k => !a.testBit k || b.testBit k

theorem mono3B_of (a : ℕ) (h : ∀ k < 8, ∀ b < 3, a.testBit k = true → a.testBit (k ||| 2 ^ b) = true) :
    mono3B a = true := by
  simp only [mono3B, List.all_eq_true, List.mem_range]
  intro k hk b hb
  cases h1 : a.testBit k
  · rfl
  · simp [h k hk b hb h1]

theorem subB_of (a b : ℕ) (h : ∀ k < 8, a.testBit k = true → b.testBit k = true) :
    subB a b = true := by
  simp only [subB, List.all_eq_true, List.mem_range]
  intro k hk
  cases h1 : a.testBit k
  · rfl
  · simp [h k hk h1]

set_option synthInstance.maxSize 100000 in set_option synthInstance.maxHeartbeats 0 in set_option maxRecDepth 100000 in set_option maxHeartbeats 0 in
theorem fact_mono : ∀ j < 4, ∀ k < 8, ∀ b < 3, (k ||| 2 ^ b) < 8 ∧ k + 8 * j < 32 ∧
    (k ||| 2 ^ b) + 8 * j < 32 ∧
    ∀ i < 5, (k + 8 * j).testBit i = true → ((k ||| 2 ^ b) + 8 * j).testBit i = true := by
  decide +kernel

def MonoM (m : ℕ) : Prop := ∀ k k', k < 32 → k' < 32 →
  (∀ i < 5, k.testBit i = true → k'.testBit i = true) → m.testBit k = true → m.testBit k' = true

theorem byte_mono (m : ℕ) (hm : MonoM m) (j : ℕ) (hj : j < 4) : mono3B (byte m j) = true := by
  apply mono3B_of
  intro k hk b hb h1
  obtain ⟨e1, e2, e3, e4⟩ := fact_mono j hj k hk b hb
  rw [testBit_byte] at h1 ⊢
  simp only [e1, hk, decide_true, Bool.true_and] at h1 ⊢
  exact hm _ _ e2 e3 e4 h1

theorem byte_sub (m : ℕ) (hm : MonoM m) (j j' : ℕ)
    (h : ∀ k < 8, k + 8 * j < 32 ∧ k + 8 * j' < 32 ∧
      ∀ i < 5, (k + 8 * j).testBit i = true → (k + 8 * j').testBit i = true) :
    subB (byte m j) (byte m j') = true := by
  apply subB_of
  intro k hk h1
  obtain ⟨e1, e2, e3⟩ := h k hk
  rw [testBit_byte] at h1 ⊢
  simp only [hk, decide_true, Bool.true_and] at h1 ⊢
  exact hm _ _ e1 e2 e3 h1

