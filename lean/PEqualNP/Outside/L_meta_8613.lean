theorem inv_ok : ∀ p < 120, ∀ i < 5,
    (invs.getD p []).getD ((perms.getD p []).getD i 0 % 5) 0 % 5 = i := by
  decide +kernel

def pi (p : ℕ) (i : Fin 5) : Fin 5 := ⟨(perms.getD p []).getD i 0 % 5, Nat.mod_lt _ (by norm_num)⟩

def rho (p : ℕ) (i : Fin 5) : Fin 5 := ⟨(invs.getD p []).getD i 0 % 5, Nat.mod_lt _ (by norm_num)⟩

theorem rho_pi (p : ℕ) (hp : p < 120) (i : Fin 5) : rho p (pi p i) = i :=
  Fin.ext (inv_ok p hp i i.isLt)

theorem pIdx_idx (p : ℕ) (x : Fin 5 → Bool) : pIdx (perms.getD p []) (idx x) = idx (x ∘ pi p) := by
  unfold pIdx
  congr 1
  funext i
  exact tb x _ _

theorem testBit_applyP (p m k : ℕ) (hp : p < 120) (hk : k < 32) :
    (applyP p m).testBit k = m.testBit (pIdx (perms.getD p []) k) := by
  rw [applyP, testBit_bitsToNat, PT_ok p hp, pIdx_eq]
  simp [List.getD_eq_getElem?_getD, hk]

